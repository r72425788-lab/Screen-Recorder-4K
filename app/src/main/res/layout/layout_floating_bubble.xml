<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Collapsed Main Bubble Root -->
    <LinearLayout
        android:id="@+id/ll_bubble_root"
        android:layout_width="wrap_content"
        android:layout_height=" wrap_content"
        android:background="@drawable/bg_floating_bubble"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/iv_floating_status"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_record_dot" />

        <TextView
            android:id="@+id/tv_floating_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded Horizontal Controls Menu -->
    <LinearLayout
        android:id="@+id/ll_expanded_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_floating_menu"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_float_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pause or Resume"
            android:padding="6dp"
            android:src="@drawable/ic_pause_small" />

        <ImageButton
            android:id="@+id/btn_float_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop Recording"
            android:padding="6dp"
            android:src="@drawable/ic_stop_small" />

        <ImageButton
            android:id="@+id/btn_float_screenshot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Screenshot"
            android:padding="6dp"
            android:src="@drawable/ic_camera_small" />

        <ImageButton
            android:id="@+id/btn_float_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Menu"
            android:padding="6dp"
            android:src="@drawable/ic_close_small" />
    </LinearLayout>

</LinearLayout>
